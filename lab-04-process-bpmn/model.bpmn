        <bpmndi:BPMNLabel>
          <dc:Bounds x="1095" y="1053" width="80" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="Shape_Task_CRM_InitCheckout" bpmnElement="Task_CRM_InitCheckout">
        <dc:Bounds x="975" y="1140" width="170" height="84" />
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="Shape_Task_CRM_SendCheckoutUrl" bpmnElement="Task_CRM_SendCheckoutUrl">
        <dc:Bounds x="975" y="1260" width="170" height="80" />
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="Shape_Gateway_CRM_EventLoopMerge" bpmnElement="Gateway_CRM_EventLoopMerge" isMarkerVisible="true">
        <dc:Bounds x="1035" y="1385" width="50" height="50" />
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="Shape_Gateway_CRM_WaitEvents" bpmnElement="Gateway_CRM_WaitEvents">
