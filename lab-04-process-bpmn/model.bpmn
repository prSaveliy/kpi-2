<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                  xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
                  xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
                  xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
                  id="Definitions_BilliardCRM_UC04_UC06"
                  targetNamespace="http://billiard-crm.kpi.ua/bpmn/uc04-registration">

  <!-- ==================== COLLABORATION (POOLS & MESSAGE FLOWS) ==================== -->
  <bpmn:collaboration id="Collaboration_TournamentRegistration">
    <bpmn:participant id="Participant_User" name="Користувач" processRef="Process_User" />
    <bpmn:participant id="Participant_CRM" name="Billiard CRM" processRef="Process_CRM" />
    <bpmn:participant id="Participant_Gateway" name="Payment Gateway" />

    <!-- Message Flows between User, Billiard CRM, and Payment Gateway -->
    <bpmn:messageFlow id="MF_RegisterReq" name="POST /registrations (JWT)" sourceRef="Task_User_ClickRegister" targetRef="StartEvent_CRM_RegReq" />
    <bpmn:messageFlow id="MF_RejectResp" name="403 Forbidden / 409 Conflict" sourceRef="Task_CRM_SendReject" targetRef="Event_User_CatchReject" />
    <bpmn:messageFlow id="MF_CreateSession" name="POST /v1/checkout/sessions" sourceRef="Task_CRM_InitCheckout" targetRef="Participant_Gateway" />
    <bpmn:messageFlow id="MF_SessionCreated" name="200 OK {session_id, checkout_url}" sourceRef="Participant_Gateway" targetRef="Task_CRM_InitCheckout" />
    <bpmn:messageFlow id="MF_CheckoutUrl" name="201 / 200 {checkout_url}" sourceRef="Task_CRM_SendCheckoutUrl" targetRef="Event_User_CatchCheckout" />
    <bpmn:messageFlow id="MF_SubmitCard" name="submitPayment(cardDetails)" sourceRef="Task_User_SubmitPayment" targetRef="Participant_Gateway" />
    <bpmn:messageFlow id="MF_WebhookFailed" name="Webhook charge.failed" sourceRef="Participant_Gateway" targetRef="Event_CRM_WebhookFailed" />
    <bpmn:messageFlow id="MF_WebhookFailAck" name="200 OK (Ack)" sourceRef="Task_CRM_AckFailWebhook" targetRef="Participant_Gateway" />
    <bpmn:messageFlow id="MF_RedirectFail" name="redirect(failure_url)" sourceRef="Participant_Gateway" targetRef="Event_User_CatchPayError" />
    <bpmn:messageFlow id="MF_RetryReq" name="POST /retry-payment" sourceRef="Task_User_ClickRetry" targetRef="Event_CRM_CatchRetry" />
    <bpmn:messageFlow id="MF_RetrySessionReq" name="POST /v1/checkout/sessions" sourceRef="Task_CRM_CreateRetrySession" targetRef="Participant_Gateway" />
    <bpmn:messageFlow id="MF_RetrySessionResp" name="200 OK {new_checkout_url}" sourceRef="Participant_Gateway" targetRef="Task_CRM_CreateRetrySession" />
    <bpmn:messageFlow id="MF_RetryCheckoutUrl" name="200 OK {new_checkout_url}" sourceRef="Task_CRM_SendRetryUrl" targetRef="Event_User_CatchRetryUrl" />
    <bpmn:messageFlow id="MF_PushExpired" name="pushEvent(SESSION_EXPIRED)" sourceRef="Task_CRM_ExpireSession" targetRef="Event_User_CatchExpired" />
    <bpmn:messageFlow id="MF_WebhookSuccess" name="Webhook charge.successful" sourceRef="Participant_Gateway" targetRef="Event_CRM_WebhookSuccess" />
    <bpmn:messageFlow id="MF_PushConfirmed" name="pushEvent(REGISTRATION_CONFIRMED)" sourceRef="Task_CRM_PushConfirmed" targetRef="Event_User_CatchConfirmed" />
    <bpmn:messageFlow id="MF_WebhookSuccessAck" name="200 OK (Webhook Ack)" sourceRef="Task_CRM_AckWebhook" targetRef="Participant_Gateway" />
  </bpmn:collaboration>

  <!-- ==================== POOL 1: КОРИСТУВАЧ ==================== -->
  <bpmn:process id="Process_User" isExecutable="false">
    <bpmn:startEvent id="StartEvent_User" name="Намір взяти участь у турнірі">
      <bpmn:outgoing>Flow_U1</bpmn:outgoing>
    </bpmn:startEvent>

    <bpmn:userTask id="Task_User_ClickRegister" name="Натиснути «Зареєструватися» (clickRegister)">
      <bpmn:incoming>Flow_U1</bpmn:incoming>
      <bpmn:outgoing>Flow_U2</bpmn:outgoing>
    </bpmn:userTask>

    <bpmn:eventBasedGateway id="Gateway_User_InitResp" name="Очікування відповіді CRM">
      <bpmn:incoming>Flow_U2</bpmn:incoming>
      <bpmn:outgoing>Flow_U_ToReject</bpmn:outgoing>
      <bpmn:outgoing>Flow_U_ToCheckout</bpmn:outgoing>
      <bpmn:outgoing>Flow_U_ToFreeConfirm</bpmn:outgoing>
    </bpmn:eventBasedGateway>

    <!-- Відмова валідації (403 / 409) -->
    <bpmn:intermediateCatchEvent id="Event_User_CatchReject" name="Отримано помилку 403 / 409">
      <bpmn:incoming>Flow_U_ToReject</bpmn:incoming>
      <bpmn:outgoing>Flow_U_Reject1</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MED_User_CatchReject" />
    </bpmn:intermediateCatchEvent>

    <bpmn:userTask id="Task_User_ViewError" name="Переглянути повідомлення про помилку">
      <bpmn:incoming>Flow_U_Reject1</bpmn:incoming>
      <bpmn:outgoing>Flow_U_Reject2</bpmn:outgoing>
    </bpmn:userTask>

    <bpmn:endEvent id="EndEvent_User_Rejected" name="У реєстрації відмовлено">
      <bpmn:incoming>Flow_U_Reject2</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Отримання посилання на оплату -->
    <bpmn:intermediateCatchEvent id="Event_User_CatchCheckout" name="Отримано checkout_url">
      <bpmn:incoming>Flow_U_ToCheckout</bpmn:incoming>
      <bpmn:outgoing>Flow_U_Checkout1</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MED_User_CatchCheckout" />
    </bpmn:intermediateCatchEvent>

    <bpmn:exclusiveGateway id="Gateway_User_PayLoopMerge">
      <bpmn:incoming>Flow_U_Checkout1</bpmn:incoming>
      <bpmn:incoming>Flow_U_RetryLoopBack</bpmn:incoming>
      <bpmn:outgoing>Flow_U_ToSubmitCard</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <bpmn:userTask id="Task_User_SubmitPayment" name="Ввести реквізити картки та оплатити (submitPayment)">
      <bpmn:incoming>Flow_U_ToSubmitCard</bpmn:incoming>
      <bpmn:outgoing>Flow_U_AfterSubmitCard</bpmn:outgoing>
    </bpmn:userTask>

    <bpmn:eventBasedGateway id="Gateway_User_WaitPayResult" name="Результат оплати">
      <bpmn:incoming>Flow_U_AfterSubmitCard</bpmn:incoming>
      <bpmn:outgoing>Flow_U_ToPaySuccess</bpmn:outgoing>
      <bpmn:outgoing>Flow_U_ToPayError</bpmn:outgoing>
      <bpmn:outgoing>Flow_U_ToExpired</bpmn:outgoing>
    </bpmn:eventBasedGateway>

    <!-- Гілка помилки оплати та повторної спроби -->
    <bpmn:intermediateCatchEvent id="Event_User_CatchPayError" name="Помилка оплати (failure_url)">
      <bpmn:incoming>Flow_U_ToPayError</bpmn:incoming>
      <bpmn:outgoing>Flow_U_PayError1</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MED_User_CatchPayError" />
    </bpmn:intermediateCatchEvent>

    <bpmn:exclusiveGateway id="Gateway_User_RetryChoice" name="Повторити? (attempts &lt; 3)">
      <bpmn:incoming>Flow_U_PayError1</bpmn:incoming>
      <bpmn:outgoing>Flow_U_RetryYes</bpmn:outgoing>
      <bpmn:outgoing>Flow_U_RetryNo</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <bpmn:userTask id="Task_User_ClickRetry" name="Натиснути «Спробувати знову» (clickRetryPayment)">
      <bpmn:incoming>Flow_U_RetryYes</bpmn:incoming>
      <bpmn:outgoing>Flow_U_ToWaitRetryResp</bpmn:outgoing>
    </bpmn:userTask>

    <bpmn:eventBasedGateway id="Gateway_User_WaitRetryResp" name="Очікування відповіді на Retry">
      <bpmn:incoming>Flow_U_ToWaitRetryResp</bpmn:incoming>
      <bpmn:outgoing>Flow_U_RetryToUrl</bpmn:outgoing>
      <bpmn:outgoing>Flow_U_RetryToExpired</bpmn:outgoing>
    </bpmn:eventBasedGateway>

    <bpmn:intermediateCatchEvent id="Event_User_CatchRetryUrl" name="Отримано новий checkout_url">
      <bpmn:incoming>Flow_U_RetryToUrl</bpmn:incoming>
      <bpmn:outgoing>Flow_U_RetryLoopBack</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MED_User_CatchRetryUrl" />
    </bpmn:intermediateCatchEvent>

    <bpmn:endEvent id="EndEvent_User_GiveUp" name="Оплату скасовано">
      <bpmn:incoming>Flow_U_RetryNo</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Гілка тайм-ауту броні -->
    <bpmn:intermediateCatchEvent id="Event_User_CatchExpired" name="Сповіщення SESSION_EXPIRED">
      <bpmn:incoming>Flow_U_ToExpired</bpmn:incoming>
      <bpmn:incoming>Flow_U_RetryToExpired</bpmn:incoming>
      <bpmn:outgoing>Flow_U_Expired1</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MED_User_CatchExpired" />
    </bpmn:intermediateCatchEvent>

    <bpmn:endEvent id="EndEvent_User_Expired" name="Час броні вичерпано">
      <bpmn:incoming>Flow_U_Expired1</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Гілка підтвердження участі -->
    <bpmn:intermediateCatchEvent id="Event_User_CatchConfirmed" name="Сповіщення REGISTRATION_CONFIRMED">
      <bpmn:incoming>Flow_U_ToPaySuccess</bpmn:incoming>
      <bpmn:incoming>Flow_U_ToFreeConfirm</bpmn:incoming>
      <bpmn:outgoing>Flow_U_Confirmed1</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MED_User_CatchConfirmed" />
    </bpmn:intermediateCatchEvent>

    <bpmn:userTask id="Task_User_ViewSuccess" name="Переглянути підтвердження реєстрації (showNotification)">
      <bpmn:incoming>Flow_U_Confirmed1</bpmn:incoming>
      <bpmn:outgoing>Flow_U_Confirmed2</bpmn:outgoing>
    </bpmn:userTask>

    <bpmn:endEvent id="EndEvent_User_Success" name="Участь у турнірі підтверджено">
      <bpmn:incoming>Flow_U_Confirmed2</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Sequence Flows in Process_User -->
    <bpmn:sequenceFlow id="Flow_U1" sourceRef="StartEvent_User" targetRef="Task_User_ClickRegister" />
    <bpmn:sequenceFlow id="Flow_U2" sourceRef="Task_User_ClickRegister" targetRef="Gateway_User_InitResp" />
    <bpmn:sequenceFlow id="Flow_U_ToReject" sourceRef="Gateway_User_InitResp" targetRef="Event_User_CatchReject" />
    <bpmn:sequenceFlow id="Flow_U_Reject1" sourceRef="Event_User_CatchReject" targetRef="Task_User_ViewError" />
    <bpmn:sequenceFlow id="Flow_U_Reject2" sourceRef="Task_User_ViewError" targetRef="EndEvent_User_Rejected" />
    <bpmn:sequenceFlow id="Flow_U_ToCheckout" sourceRef="Gateway_User_InitResp" targetRef="Event_User_CatchCheckout" />
    <bpmn:sequenceFlow id="Flow_U_ToFreeConfirm" name="entry_fee == 0" sourceRef="Gateway_User_InitResp" targetRef="Event_User_CatchConfirmed" />
    <bpmn:sequenceFlow id="Flow_U_Checkout1" sourceRef="Event_User_CatchCheckout" targetRef="Gateway_User_PayLoopMerge" />
    <bpmn:sequenceFlow id="Flow_U_ToSubmitCard" sourceRef="Gateway_User_PayLoopMerge" targetRef="Task_User_SubmitPayment" />
    <bpmn:sequenceFlow id="Flow_U_AfterSubmitCard" sourceRef="Task_User_SubmitPayment" targetRef="Gateway_User_WaitPayResult" />
    <bpmn:sequenceFlow id="Flow_U_ToPaySuccess" sourceRef="Gateway_User_WaitPayResult" targetRef="Event_User_CatchConfirmed" />
    <bpmn:sequenceFlow id="Flow_U_ToPayError" sourceRef="Gateway_User_WaitPayResult" targetRef="Event_User_CatchPayError" />
    <bpmn:sequenceFlow id="Flow_U_PayError1" sourceRef="Event_User_CatchPayError" targetRef="Gateway_User_RetryChoice" />
    <bpmn:sequenceFlow id="Flow_U_RetryYes" name="Так" sourceRef="Gateway_User_RetryChoice" targetRef="Task_User_ClickRetry" />
    <bpmn:sequenceFlow id="Flow_U_ToWaitRetryResp" sourceRef="Task_User_ClickRetry" targetRef="Gateway_User_WaitRetryResp" />
    <bpmn:sequenceFlow id="Flow_U_RetryToUrl" sourceRef="Gateway_User_WaitRetryResp" targetRef="Event_User_CatchRetryUrl" />
    <bpmn:sequenceFlow id="Flow_U_RetryToExpired" sourceRef="Gateway_User_WaitRetryResp" targetRef="Event_User_CatchExpired" />
    <bpmn:sequenceFlow id="Flow_U_RetryLoopBack" sourceRef="Event_User_CatchRetryUrl" targetRef="Gateway_User_PayLoopMerge" />
    <bpmn:sequenceFlow id="Flow_U_RetryNo" name="Ні" sourceRef="Gateway_User_RetryChoice" targetRef="EndEvent_User_GiveUp" />
    <bpmn:sequenceFlow id="Flow_U_ToExpired" sourceRef="Gateway_User_WaitPayResult" targetRef="Event_User_CatchExpired" />
    <bpmn:sequenceFlow id="Flow_U_Expired1" sourceRef="Event_User_CatchExpired" targetRef="EndEvent_User_Expired" />
    <bpmn:sequenceFlow id="Flow_U_Confirmed1" sourceRef="Event_User_CatchConfirmed" targetRef="Task_User_ViewSuccess" />
    <bpmn:sequenceFlow id="Flow_U_Confirmed2" sourceRef="Task_User_ViewSuccess" targetRef="EndEvent_User_Success" />
  </bpmn:process>

  <!-- ==================== POOL 2: BILLIARD CRM ==================== -->
  <bpmn:process id="Process_CRM" isExecutable="true">
    <!-- Data Objects for tournament_registration -->
    <bpmn:dataObject id="DataObject_TournamentRegistration" />
    <bpmn:dataObjectReference id="DataObjectRef_RegPending" name="tournament_registration [PENDING]" dataObjectRef="DataObject_TournamentRegistration" />
    <bpmn:dataObjectReference id="DataObjectRef_RegPaid" name="tournament_registration [PAID]" dataObjectRef="DataObject_TournamentRegistration" />

    <!-- Етап 1: Ініціація та перевірка умов допуску -->
    <bpmn:startEvent id="StartEvent_CRM_RegReq" name="Отримано POST /registrations">
      <bpmn:outgoing>Flow_C1</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MED_CRM_RegReq" />
    </bpmn:startEvent>

    <bpmn:serviceTask id="Task_CRM_Auth" name="Валідувати JWT-токен та роль гравця (verifyJwtAndRole)">
      <bpmn:incoming>Flow_C1</bpmn:incoming>
      <bpmn:outgoing>Flow_C2</bpmn:outgoing>
    </bpmn:serviceTask>

    <bpmn:serviceTask id="Task_CRM_CheckDB" name="Перевірити турнір (FOR UPDATE), квоту з 15-хв TTL та existing_reg">
      <bpmn:incoming>Flow_C2</bpmn:incoming>
      <bpmn:outgoing>Flow_C3</bpmn:outgoing>
    </bpmn:serviceTask>

    <bpmn:exclusiveGateway id="Gateway_CRM_Validate" name="Результат перевірки?">
      <bpmn:incoming>Flow_C3</bpmn:incoming>
      <bpmn:outgoing>Flow_C_ToReject</bpmn:outgoing>
      <bpmn:outgoing>Flow_C_ToPendingResume</bpmn:outgoing>
      <bpmn:outgoing>Flow_C_ToNewInsert</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Гілка 1: Відмова (403 / 409) — Send Task (конверт) -->
    <bpmn:sendTask id="Task_CRM_SendReject" name="Повернути помилку 403 / 409 (без INSERT у БД)">
      <bpmn:incoming>Flow_C_ToReject</bpmn:incoming>
      <bpmn:outgoing>Flow_C_RejectEnd</bpmn:outgoing>
    </bpmn:sendTask>

    <bpmn:endEvent id="EndEvent_CRM_Rejected" name="Заявку відхилено">
      <bpmn:incoming>Flow_C_RejectEnd</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Гілка 2: Відновлення існуючої заявки PENDING -->
    <bpmn:exclusiveGateway id="Gateway_CRM_CheckTtlExpired" name="TTL &gt; 15 хв?">
      <bpmn:incoming>Flow_C_ToPendingResume</bpmn:incoming>
      <bpmn:outgoing>Flow_C_TtlExpiredYes</bpmn:outgoing>
      <bpmn:outgoing>Flow_C_TtlExpiredNo</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <bpmn:serviceTask id="Task_CRM_UpdateTtl" name="Оновити час броні (UPDATE registered_at = NOW())">
      <bpmn:incoming>Flow_C_TtlExpiredYes</bpmn:incoming>
      <bpmn:outgoing>Flow_C_AfterUpdateTtl</bpmn:outgoing>
      <bpmn:dataOutputAssociation id="DOA_UpdateTtl">
        <bpmn:targetRef>DataObjectRef_RegPending</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:serviceTask>

    <bpmn:exclusiveGateway id="Gateway_CRM_MergePending">
      <bpmn:incoming>Flow_C_AfterUpdateTtl</bpmn:incoming>
      <bpmn:incoming>Flow_C_TtlExpiredNo</bpmn:incoming>
      <bpmn:outgoing>Flow_C_PendingMerged</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Гілка 3: Створення нової заявки -->
    <bpmn:serviceTask id="Task_CRM_InsertPending" name="Створити заявку PENDING (INSERT tournament_registration)">
      <bpmn:incoming>Flow_C_ToNewInsert</bpmn:incoming>
      <bpmn:outgoing>Flow_C_AfterInsert</bpmn:outgoing>
      <bpmn:dataOutputAssociation id="DOA_InsertPending">
        <bpmn:targetRef>DataObjectRef_RegPending</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:serviceTask>

    <!-- Етап 2: Перевірка платності та створення Checkout-сесії -->
    <bpmn:exclusiveGateway id="Gateway_CRM_MergeBeforeFee">
      <bpmn:incoming>Flow_C_PendingMerged</bpmn:incoming>
      <bpmn:incoming>Flow_C_AfterInsert</bpmn:incoming>
      <bpmn:outgoing>Flow_C_ToCheckFee</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <bpmn:exclusiveGateway id="Gateway_CRM_CheckFee" name="entry_fee &gt; 0?">
      <bpmn:incoming>Flow_C_ToCheckFee</bpmn:incoming>
      <bpmn:outgoing>Flow_C_FeePositive</bpmn:outgoing>
      <bpmn:outgoing>Flow_C_FeeZero</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <bpmn:serviceTask id="Task_CRM_InitCheckout" name="Ініціювати сесію оплати в шлюзі (initiateCheckout)">
      <bpmn:incoming>Flow_C_FeePositive</bpmn:incoming>
      <bpmn:outgoing>Flow_C_ToSendCheckoutUrl</bpmn:outgoing>
      <bpmn:property id="Property_InitCheckout_Reg" name="__targetRef_placeholder" />
      <bpmn:dataInputAssociation id="DIA_InitCheckout">
        <bpmn:sourceRef>DataObjectRef_RegPending</bpmn:sourceRef>
        <bpmn:targetRef>Property_InitCheckout_Reg</bpmn:targetRef>
      </bpmn:dataInputAssociation>
    </bpmn:serviceTask>

    <bpmn:sendTask id="Task_CRM_SendCheckoutUrl" name="Надіслати checkout_url користувачу">
      <bpmn:incoming>Flow_C_ToSendCheckoutUrl</bpmn:incoming>
      <bpmn:outgoing>Flow_C_AfterInitCheckout</bpmn:outgoing>
    </bpmn:sendTask>

    <!-- Етап 3: Оплата, повторні спроби (Retry) та очікування подій -->
    <bpmn:exclusiveGateway id="Gateway_CRM_EventLoopMerge">
      <bpmn:incoming>Flow_C_AfterInitCheckout</bpmn:incoming>
      <bpmn:incoming>Flow_C_RetryLoopBack</bpmn:incoming>
      <bpmn:outgoing>Flow_C_ToWaitEvents</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <bpmn:eventBasedGateway id="Gateway_CRM_WaitEvents" name="Очікування Webhook або TTL">
      <bpmn:incoming>Flow_C_ToWaitEvents</bpmn:incoming>
      <bpmn:outgoing>Flow_C_ToWebhookSuccess</bpmn:outgoing>
      <bpmn:outgoing>Flow_C_ToWebhookFailed</bpmn:outgoing>
      <bpmn:outgoing>Flow_C_ToTimerTtl</bpmn:outgoing>
    </bpmn:eventBasedGateway>

    <!-- Подія 1: Webhook charge.successful -->
    <bpmn:intermediateCatchEvent id="Event_CRM_WebhookSuccess" name="Webhook charge.successful">
      <bpmn:incoming>Flow_C_ToWebhookSuccess</bpmn:incoming>
      <bpmn:outgoing>Flow_C_AfterWebhookSuccess</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MED_CRM_WebhookSuccess" />
    </bpmn:intermediateCatchEvent>

    <bpmn:serviceTask id="Task_CRM_VerifySuccessSig" name="Перевірити HMAC-підпис вебхука (verifyHmacSignature)">
      <bpmn:incoming>Flow_C_AfterWebhookSuccess</bpmn:incoming>
      <bpmn:outgoing>Flow_C_VerifiedSuccess</bpmn:outgoing>
    </bpmn:serviceTask>

    <bpmn:sendTask id="Task_CRM_AckWebhook" name="Підтвердити вебхук (200 OK)">
      <bpmn:incoming>Flow_C_VerifiedSuccess</bpmn:incoming>
      <bpmn:outgoing>Flow_C_AfterAckWebhook</bpmn:outgoing>
    </bpmn:sendTask>

    <!-- Подія 2: Webhook charge.failed -->
    <bpmn:intermediateCatchEvent id="Event_CRM_WebhookFailed" name="Webhook charge.failed">
      <bpmn:incoming>Flow_C_ToWebhookFailed</bpmn:incoming>
      <bpmn:outgoing>Flow_C_AfterWebhookFailed</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MED_CRM_WebhookFailed" />
    </bpmn:intermediateCatchEvent>

    <bpmn:serviceTask id="Task_CRM_VerifyFailSig" name="Перевірити HMAC-підпис та зберегти PENDING">
      <bpmn:incoming>Flow_C_AfterWebhookFailed</bpmn:incoming>
      <bpmn:outgoing>Flow_C_ToAckFail</bpmn:outgoing>
    </bpmn:serviceTask>

    <bpmn:sendTask id="Task_CRM_AckFailWebhook" name="Підтвердити помилковий вебхук (200 OK)">
      <bpmn:incoming>Flow_C_ToAckFail</bpmn:incoming>
      <bpmn:outgoing>Flow_C_ToCatchRetry</bpmn:outgoing>
    </bpmn:sendTask>

    <bpmn:intermediateCatchEvent id="Event_CRM_CatchRetry" name="Отримано POST /retry-payment">
      <bpmn:incoming>Flow_C_ToCatchRetry</bpmn:incoming>
      <bpmn:outgoing>Flow_C_AfterCatchRetry</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MED_CRM_CatchRetry" />
    </bpmn:intermediateCatchEvent>

    <bpmn:exclusiveGateway id="Gateway_CRM_CheckRetry" name="attempts &lt; 3 та TTL дійсний?">
      <bpmn:incoming>Flow_C_AfterCatchRetry</bpmn:incoming>
      <bpmn:outgoing>Flow_C_AllowRetryYes</bpmn:outgoing>
      <bpmn:outgoing>Flow_C_AllowRetryNo</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <bpmn:serviceTask id="Task_CRM_CreateRetrySession" name="Створити нову Checkout-сесію (createRetrySession)">
      <bpmn:incoming>Flow_C_AllowRetryYes</bpmn:incoming>
      <bpmn:outgoing>Flow_C_ToSendRetryUrl</bpmn:outgoing>
    </bpmn:serviceTask>

    <bpmn:sendTask id="Task_CRM_SendRetryUrl" name="Надіслати новий checkout_url користувачу">
      <bpmn:incoming>Flow_C_ToSendRetryUrl</bpmn:incoming>
      <bpmn:outgoing>Flow_C_RetryLoopBack</bpmn:outgoing>
    </bpmn:sendTask>

    <!-- Подія 4: Тайм-аут броні min(registered_at + 15 хв, deadline) -->
    <bpmn:intermediateCatchEvent id="Event_CRM_TimerTtl" name="Тайм-аут min(registered_at + 15 хв, deadline)">
      <bpmn:incoming>Flow_C_ToTimerTtl</bpmn:incoming>
      <bpmn:outgoing>Flow_C_TimerTriggered</bpmn:outgoing>
      <bpmn:timerEventDefinition id="TED_CRM_TimerTtl" />
    </bpmn:intermediateCatchEvent>

    <bpmn:exclusiveGateway id="Gateway_CRM_MergeExpire">
      <bpmn:incoming>Flow_C_TimerTriggered</bpmn:incoming>
      <bpmn:incoming>Flow_C_AllowRetryNo</bpmn:incoming>
      <bpmn:outgoing>Flow_C_ToExpireTask</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <bpmn:sendTask id="Task_CRM_ExpireSession" name="Залишити PENDING (слот вільний), надіслати SESSION_EXPIRED">
      <bpmn:incoming>Flow_C_ToExpireTask</bpmn:incoming>
      <bpmn:outgoing>Flow_C_ToExpireEnd</bpmn:outgoing>
    </bpmn:sendTask>

    <bpmn:endEvent id="EndEvent_CRM_Expired" name="Сесію завершено за тайм-аутом">
      <bpmn:incoming>Flow_C_ToExpireEnd</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Етап 4: Паралельне підтвердження реєстрації в БД та сповіщення клієнта -->
    <bpmn:exclusiveGateway id="Gateway_CRM_MergeToConfirm">
      <bpmn:incoming>Flow_C_AfterAckWebhook</bpmn:incoming>
      <bpmn:incoming>Flow_C_FeeZero</bpmn:incoming>
      <bpmn:outgoing>Flow_C_ToParFork</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <bpmn:parallelGateway id="Gateway_CRM_ParFork" name="Fork">
      <bpmn:incoming>Flow_C_ToParFork</bpmn:incoming>
      <bpmn:outgoing>Flow_C_ParBranch1</bpmn:outgoing>
      <bpmn:outgoing>Flow_C_ParBranch2</bpmn:outgoing>
    </bpmn:parallelGateway>

    <bpmn:serviceTask id="Task_CRM_UpdatePaid" name="Оновити статус у БД на PAID (UPDATE tournament_registration)">
      <bpmn:incoming>Flow_C_ParBranch1</bpmn:incoming>
      <bpmn:outgoing>Flow_C_ParJoin1</bpmn:outgoing>
      <bpmn:dataOutputAssociation id="DOA_UpdatePaid">
        <bpmn:targetRef>DataObjectRef_RegPaid</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:serviceTask>

    <bpmn:sendTask id="Task_CRM_PushConfirmed" name="Надіслати pushEvent(REGISTRATION_CONFIRMED)">
      <bpmn:incoming>Flow_C_ParBranch2</bpmn:incoming>
      <bpmn:outgoing>Flow_C_ParJoin2</bpmn:outgoing>
    </bpmn:sendTask>

    <bpmn:parallelGateway id="Gateway_CRM_ParJoin" name="Join">
      <bpmn:incoming>Flow_C_ParJoin1</bpmn:incoming>
      <bpmn:incoming>Flow_C_ParJoin2</bpmn:incoming>
      <bpmn:outgoing>Flow_C_ToSuccessEnd</bpmn:outgoing>
    </bpmn:parallelGateway>

    <bpmn:endEvent id="EndEvent_CRM_Success" name="Реєстрацію успішно підтверджено">
      <bpmn:incoming>Flow_C_ToSuccessEnd</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Sequence Flows in Process_CRM -->
    <bpmn:sequenceFlow id="Flow_C1" sourceRef="StartEvent_CRM_RegReq" targetRef="Task_CRM_Auth" />
    <bpmn:sequenceFlow id="Flow_C2" sourceRef="Task_CRM_Auth" targetRef="Task_CRM_CheckDB" />
    <bpmn:sequenceFlow id="Flow_C3" sourceRef="Task_CRM_CheckDB" targetRef="Gateway_CRM_Validate" />
    <bpmn:sequenceFlow id="Flow_C_ToReject" name="Порушено інваріант (403/409)" sourceRef="Gateway_CRM_Validate" targetRef="Task_CRM_SendReject" />
    <bpmn:sequenceFlow id="Flow_C_RejectEnd" sourceRef="Task_CRM_SendReject" targetRef="EndEvent_CRM_Rejected" />
    <bpmn:sequenceFlow id="Flow_C_ToPendingResume" name="Існує PENDING" sourceRef="Gateway_CRM_Validate" targetRef="Gateway_CRM_CheckTtlExpired" />
    <bpmn:sequenceFlow id="Flow_C_TtlExpiredYes" name="Так" sourceRef="Gateway_CRM_CheckTtlExpired" targetRef="Task_CRM_UpdateTtl" />
    <bpmn:sequenceFlow id="Flow_C_AfterUpdateTtl" sourceRef="Task_CRM_UpdateTtl" targetRef="Gateway_CRM_MergePending" />
    <bpmn:sequenceFlow id="Flow_C_TtlExpiredNo" name="Ні" sourceRef="Gateway_CRM_CheckTtlExpired" targetRef="Gateway_CRM_MergePending" />
    <bpmn:sequenceFlow id="Flow_C_PendingMerged" sourceRef="Gateway_CRM_MergePending" targetRef="Gateway_CRM_MergeBeforeFee" />
    <bpmn:sequenceFlow id="Flow_C_ToNewInsert" name="Нова заявка" sourceRef="Gateway_CRM_Validate" targetRef="Task_CRM_InsertPending" />
    <bpmn:sequenceFlow id="Flow_C_AfterInsert" sourceRef="Task_CRM_InsertPending" targetRef="Gateway_CRM_MergeBeforeFee" />
    <bpmn:sequenceFlow id="Flow_C_ToCheckFee" sourceRef="Gateway_CRM_MergeBeforeFee" targetRef="Gateway_CRM_CheckFee" />
    <bpmn:sequenceFlow id="Flow_C_FeePositive" name="entry_fee &gt; 0" sourceRef="Gateway_CRM_CheckFee" targetRef="Task_CRM_InitCheckout" />
    <bpmn:sequenceFlow id="Flow_C_FeeZero" name="entry_fee == 0" sourceRef="Gateway_CRM_CheckFee" targetRef="Gateway_CRM_MergeToConfirm" />
    <bpmn:sequenceFlow id="Flow_C_ToSendCheckoutUrl" sourceRef="Task_CRM_InitCheckout" targetRef="Task_CRM_SendCheckoutUrl" />
    <bpmn:sequenceFlow id="Flow_C_AfterInitCheckout" sourceRef="Task_CRM_SendCheckoutUrl" targetRef="Gateway_CRM_EventLoopMerge" />
    <bpmn:sequenceFlow id="Flow_C_ToWaitEvents" sourceRef="Gateway_CRM_EventLoopMerge" targetRef="Gateway_CRM_WaitEvents" />
    <bpmn:sequenceFlow id="Flow_C_ToWebhookSuccess" sourceRef="Gateway_CRM_WaitEvents" targetRef="Event_CRM_WebhookSuccess" />
    <bpmn:sequenceFlow id="Flow_C_AfterWebhookSuccess" sourceRef="Event_CRM_WebhookSuccess" targetRef="Task_CRM_VerifySuccessSig" />
    <bpmn:sequenceFlow id="Flow_C_VerifiedSuccess" sourceRef="Task_CRM_VerifySuccessSig" targetRef="Task_CRM_AckWebhook" />
    <bpmn:sequenceFlow id="Flow_C_AfterAckWebhook" sourceRef="Task_CRM_AckWebhook" targetRef="Gateway_CRM_MergeToConfirm" />
    <bpmn:sequenceFlow id="Flow_C_ToWebhookFailed" sourceRef="Gateway_CRM_WaitEvents" targetRef="Event_CRM_WebhookFailed" />
    <bpmn:sequenceFlow id="Flow_C_AfterWebhookFailed" sourceRef="Event_CRM_WebhookFailed" targetRef="Task_CRM_VerifyFailSig" />
    <bpmn:sequenceFlow id="Flow_C_ToAckFail" sourceRef="Task_CRM_VerifyFailSig" targetRef="Task_CRM_AckFailWebhook" />
    <bpmn:sequenceFlow id="Flow_C_ToCatchRetry" sourceRef="Task_CRM_AckFailWebhook" targetRef="Event_CRM_CatchRetry" />
    <bpmn:sequenceFlow id="Flow_C_AfterCatchRetry" sourceRef="Event_CRM_CatchRetry" targetRef="Gateway_CRM_CheckRetry" />
    <bpmn:sequenceFlow id="Flow_C_AllowRetryYes" name="Так" sourceRef="Gateway_CRM_CheckRetry" targetRef="Task_CRM_CreateRetrySession" />
    <bpmn:sequenceFlow id="Flow_C_ToSendRetryUrl" sourceRef="Task_CRM_CreateRetrySession" targetRef="Task_CRM_SendRetryUrl" />
    <bpmn:sequenceFlow id="Flow_C_RetryLoopBack" sourceRef="Task_CRM_SendRetryUrl" targetRef="Gateway_CRM_EventLoopMerge" />
    <bpmn:sequenceFlow id="Flow_C_AllowRetryNo" name="Ні" sourceRef="Gateway_CRM_CheckRetry" targetRef="Gateway_CRM_MergeExpire" />
    <bpmn:sequenceFlow id="Flow_C_ToTimerTtl" sourceRef="Gateway_CRM_WaitEvents" targetRef="Event_CRM_TimerTtl" />
    <bpmn:sequenceFlow id="Flow_C_TimerTriggered" sourceRef="Event_CRM_TimerTtl" targetRef="Gateway_CRM_MergeExpire" />
    <bpmn:sequenceFlow id="Flow_C_ToExpireTask" sourceRef="Gateway_CRM_MergeExpire" targetRef="Task_CRM_ExpireSession" />
    <bpmn:sequenceFlow id="Flow_C_ToExpireEnd" sourceRef="Task_CRM_ExpireSession" targetRef="EndEvent_CRM_Expired" />
    <bpmn:sequenceFlow id="Flow_C_ToParFork" sourceRef="Gateway_CRM_MergeToConfirm" targetRef="Gateway_CRM_ParFork" />
    <bpmn:sequenceFlow id="Flow_C_ParBranch1" sourceRef="Gateway_CRM_ParFork" targetRef="Task_CRM_UpdatePaid" />
    <bpmn:sequenceFlow id="Flow_C_ParBranch2" sourceRef="Gateway_CRM_ParFork" targetRef="Task_CRM_PushConfirmed" />
    <bpmn:sequenceFlow id="Flow_C_ParJoin1" sourceRef="Task_CRM_UpdatePaid" targetRef="Gateway_CRM_ParJoin" />
    <bpmn:sequenceFlow id="Flow_C_ParJoin2" sourceRef="Task_CRM_PushConfirmed" targetRef="Gateway_CRM_ParJoin" />
    <bpmn:sequenceFlow id="Flow_C_ToSuccessEnd" sourceRef="Gateway_CRM_ParJoin" targetRef="EndEvent_CRM_Success" />
  </bpmn:process>

  <!-- ==================== BPMN DI (VERTICAL LAYOUT & COORDINATES) ==================== -->
  <bpmndi:BPMNDiagram id="BPMNDiagram_1">
    <bpmndi:BPMNPlane id="BPMNPlane_1" bpmnElement="Collaboration_TournamentRegistration">

